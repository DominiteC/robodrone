#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
ANO_DT协议解析模块
用于解析STM32无人机ANO_DT协议数据帧，特别支持高频振动数据（0xF2帧）

协议帧格式：
  0     1     2     3     4     ...    n-1
+-----+-----+-----+-----+-----+-----+-----+
| 0xAA| 0xAA| FUNC| LEN | DATA ... | SUM |
+-----+-----+-----+-----+-----+-----+-----+
  帧头  帧头  功能码 长度  数据部分  校验和

功能码定义：
  0x00: 版本信息     0x01: 状态信息
  0x02: 传感器数据   0x03: RC数据
  0x05: 电源信息     0x06: 电机PWM
  0x10-0x15: PID参数
  0xF1: 角速度调试数据
  0xF2: 高频振动数据（自定义扩展）
"""

import struct
import time
from dataclasses import dataclass
from typing import Dict, List, Optional, Tuple, Union
from enum import IntEnum


class ANOFunctionCode(IntEnum):
    """ANO_DT协议功能码枚举"""
    VERSION = 0x00      # 版本信息
    STATUS = 0x01       # 状态信息
    SENSOR = 0x02       # 传感器数据
    RC_DATA = 0x03      # RC数据
    POWER = 0x05        # 电源信息
    MOTO_PWM = 0x06     # 电机PWM
    PID1 = 0x10         # PID参数组1
    PID2 = 0x11         # PID参数组2
    PID3 = 0x12         # PID参数组3
    PID4 = 0x13         # PID参数组4
    PID5 = 0x14         # PID参数组5
    PID6 = 0x15         # PID参数组6
    ANGLE_RATE = 0xF1   # 角速度调试数据
    VIBRATION = 0xF2    # 高频振动数据（自定义扩展）


@dataclass
class VibrationData:
    """高频振动数据结构（功能码0xF2）"""
    timestamp_ms: int        # 时间戳（毫秒）
    raw_gx: float              # 原始陀螺仪X轴（°/s）
    raw_gy: float              # 原始陀螺仪Y轴（°/s）
    raw_gz: float              # 原始陀螺仪Z轴（°/s）
    filt_gx: float           # 滤波后角速度X轴（°/s）
    filt_gy: float           # 滤波后角速度Y轴（°/s）
    filt_gz: float           # 滤波后角速度Z轴（°/s）
    pid_roll_out: float      # 横滚环PID输出
    pid_pitch_out: float     # 俯仰环PID输出
    pid_yaw_out: float       # 航向环PID输出
    pid_roll_err: float      # 横滚环PID误差
    pid_pitch_err: float     # 俯仰环PID误差
    pid_yaw_err: float       # 航向环PID误差
    
    def to_dict(self) -> Dict[str, Union[int, float]]:
        """转换为字典格式，便于CSV保存"""
        return {
            'timestamp_ms': self.timestamp_ms,
            'raw_gx': self.raw_gx,
            'raw_gy': self.raw_gy,
            'raw_gz': self.raw_gz,
            'filt_gx': self.filt_gx,
            'filt_gy': self.filt_gy,
            'filt_gz': self.filt_gz,
            'pid_roll_out': self.pid_roll_out,
            'pid_pitch_out': self.pid_pitch_out,
            'pid_yaw_out': self.pid_yaw_out,
            'pid_roll_err': self.pid_roll_err,
            'pid_pitch_err': self.pid_pitch_err,
            'pid_yaw_err': self.pid_yaw_err,
        }
    
    @classmethod
    def get_csv_header(cls) -> str:
        """获取CSV文件头"""
        return 'timestamp_ms,raw_gx,raw_gy,raw_gz,filt_gx,filt_gy,filt_gz,' \
               'pid_roll_out,pid_pitch_out,pid_yaw_out,' \
               'pid_roll_err,pid_pitch_err,pid_yaw_err'
    
    def to_csv_row(self) -> str:
        """转换为CSV行"""
        return f'{self.timestamp_ms},{self.raw_gx:.6f},{self.raw_gy:.6f},{self.raw_gz:.6f},' \
               f'{self.filt_gx:.6f},{self.filt_gy:.6f},{self.filt_gz:.6f},' \
               f'{self.pid_roll_out:.6f},{self.pid_pitch_out:.6f},{self.pid_yaw_out:.6f},' \
               f'{self.pid_roll_err:.6f},{self.pid_pitch_err:.6f},{self.pid_yaw_err:.6f}'


@dataclass
class ANOFrame:
    """ANO_DT协议帧基类"""
    function_code: ANOFunctionCode  # 功能码
    data: bytes                     # 原始数据部分（不包括帧头、长度、校验和）
    checksum: int                   # 校验和
    raw_frame: bytes                # 完整原始帧（用于转发）
    
    @property
    def is_valid(self) -> bool:
        """检查校验和是否有效"""
        return self.checksum == self._calculate_checksum()
    
    def _calculate_checksum(self) -> int:
        """计算校验和（不包括校验和字节本身）"""
        return sum(self.raw_frame[:-1]) & 0xFF
    
    @classmethod
    def parse(cls, frame_data: bytes) -> Optional['ANOFrame']:
        """
        解析ANO_DT协议帧
        
        Args:
            frame_data: 完整的帧数据（包括帧头）
            
        Returns:
            ANOFrame对象或None（如果解析失败）
        """
        # 基本长度检查
        if len(frame_data) < 6:  # 最小帧：帧头(2)+功能码(1)+长度(1)+数据(0)+校验和(1)
            return None
        
        # 检查帧头
        if frame_data[0] != 0xAA or frame_data[1] != 0xAA:
            return None
        
        # 获取功能码
        try:
            func_code = ANOFunctionCode(frame_data[2])
        except ValueError:
            # 未知功能码，但仍创建基本帧对象
            func_code = frame_data[2]
        
        # 获取长度字段
        data_len = frame_data[3]
        
        # 检查帧长度是否匹配
        if len(frame_data) != data_len + 5:  # 5 = 帧头(2)+功能码(1)+长度(1)+校验和(1)
            return None
        
        # 提取数据和校验和
        data = frame_data[4:4+data_len]
        checksum = frame_data[-1]
        
        # 创建帧对象
        frame = cls(
            function_code=func_code,
            data=data,
            checksum=checksum,
            raw_frame=frame_data
        )
        
        # 验证校验和
        if not frame.is_valid:
            return None
        
        return frame


class ANOProtocolParser:
    """
    ANO_DT协议状态机解析器
    类似C代码中的ANO_DT_Data_Receive_Prepare函数
    """
    
    def __init__(self):
        """初始化解析器状态机"""
        self.reset()
        
    def reset(self):
        """重置解析器状态"""
        self.state = 0           # 状态：0=等待帧头1, 1=等待帧头2, 2=等待功能码, 3=等待长度, 4=接收数据, 5=等待校验和
        self.rx_buffer = bytearray()  # 接收缓冲区
        self.data_len = 0        # 数据长度
        self.data_cnt = 0        # 已接收数据计数
        
    def feed(self, byte_data: int) -> Optional[ANOFrame]:
        """
        喂入一个字节数据，返回解析完成的帧（如果完成）
        
        Args:
            byte_data: 一个字节数据（0-255）
            
        Returns:
            ANOFrame对象或None（如果帧未完成）
        """
        if self.state == 0 and byte_data == 0xAA:
            # 状态0: 等待帧头1
            self.state = 1
            self.rx_buffer = bytearray([byte_data])
            
        elif self.state == 1 and byte_data == 0xAA:
            # 状态1: 等待帧头2
            self.state = 2
            self.rx_buffer.append(byte_data)
            
        elif self.state == 2:
            # 状态2: 等待功能码
            self.state = 3
            self.rx_buffer.append(byte_data)
            
        elif self.state == 3:
            # 状态3: 等待长度字段
            self.state = 4
            self.data_len = byte_data
            self.data_cnt = 0
            self.rx_buffer.append(byte_data)
            
            # 长度字段有效性检查
            if self.data_len >= 50:  # ANO_DT协议最大长度限制
                self.reset()
                
        elif self.state == 4 and self.data_len > 0:
            # 状态4: 接收数据部分
            self.data_len -= 1
            self.data_cnt += 1
            self.rx_buffer.append(byte_data)
            
            if self.data_len == 0:
                self.state = 5
                
        elif self.state == 5:
            # 状态5: 等待校验和
            self.rx_buffer.append(byte_data)
            
            # 尝试解析完整帧
            frame = ANOFrame.parse(bytes(self.rx_buffer))
            
            # 重置状态机
            self.reset()
            
            return frame
            
        else:
            # 状态不匹配，重置状态机
            self.reset()
            
        return None
    
    def feed_bytes(self, data: bytes) -> List[ANOFrame]:
        """
        喂入多个字节数据，返回所有解析完成的帧
        
        Args:
            data: 字节数据
            
        Returns:
            解析完成的帧列表
        """
        frames = []
        for byte in data:
            frame = self.feed(byte)
            if frame is not None:
                frames.append(frame)
        return frames


class VibrationDataParser:
    """高频振动数据（0xF2帧）专用解析器"""
    
    @staticmethod
    def parse(frame: ANOFrame) -> Optional[VibrationData]:
        """
        解析0xF2振动数据帧
        
        Args:
            frame: ANOFrame对象（功能码必须为0xF2）
            
        Returns:
            VibrationData对象或None（如果解析失败）
        """
        if frame.function_code != ANOFunctionCode.VIBRATION:
            return None
        
        data = frame.data
        if len(data) != 46:  # 0xF2帧数据部分应为46字节
            return None
        
        try:
            # 解析时间戳 (4字节, uint32_t, 大端序)
            timestamp = struct.unpack('>I', data[0:4])[0]
            
            # 解析原始陀螺仪数据 (3×int16_t, 大端序，已乘以1000，需要除以1000还原)
            raw_gx = struct.unpack('>h', data[4:6])[0] / 1000.0
            raw_gy = struct.unpack('>h', data[6:8])[0] / 1000.0
            raw_gz = struct.unpack('>h', data[8:10])[0] / 1000.0
            
            # 解析滤波后角速度 (3×float, 大端序，已乘以1000，需要除以1000还原)
            filt_gx = struct.unpack('>f', data[10:14])[0] / 1000.0
            filt_gy = struct.unpack('>f', data[14:18])[0] / 1000.0
            filt_gz = struct.unpack('>f', data[18:22])[0] / 1000.0
            
            # 解析PID输出 (3×float, 大端序)
            pid_roll_out = struct.unpack('>f', data[22:26])[0]
            pid_pitch_out = struct.unpack('>f', data[26:30])[0]
            pid_yaw_out = struct.unpack('>f', data[30:34])[0]
            
            # 解析PID误差 (3×float, 大端序)
            pid_roll_err = struct.unpack('>f', data[34:38])[0]
            pid_pitch_err = struct.unpack('>f', data[38:42])[0]
            pid_yaw_err = struct.unpack('>f', data[42:46])[0]
            
            return VibrationData(
                timestamp_ms=timestamp,
                raw_gx=raw_gx,
                raw_gy=raw_gy,
                raw_gz=raw_gz,
                filt_gx=filt_gx,
                filt_gy=filt_gy,
                filt_gz=filt_gz,
                pid_roll_out=pid_roll_out,
                pid_pitch_out=pid_pitch_out,
                pid_yaw_out=pid_yaw_out,
                pid_roll_err=pid_roll_err,
                pid_pitch_err=pid_pitch_err,
                pid_yaw_err=pid_yaw_err
            )
            
        except (struct.error, IndexError):
            return None


# 测试帧（用于模块测试）
test_frame = bytes([
    0xAA, 0xAA, 0xF2, 0x2E,  # 帧头、功能码、长度(46)
    # 时间戳: 1234567890 (0x499602D2)
    0x49, 0x96, 0x02, 0xD2,
    # 原始陀螺仪: 100, -200, 300 (实际值已乘以1000)
    0x00, 0x64, 0xFF, 0x38, 0x01, 0x2C,
    # 滤波角速度: 1230.0, -2340.0, 3450.0 (实际值已乘以1000)
    0x44, 0x99, 0xC0, 0x00,  # 1230.0 (1.23×1000)
    0xC5, 0x12, 0x40, 0x00,  # -2340.0 (-2.34×1000)
    0x45, 0x57, 0xA0, 0x00,  # 3450.0 (3.45×1000)
    # PID输出: 0.1, 0.2, 0.3
    0x3D, 0xCC, 0xCC, 0xCD,  # 0.1
    0x3E, 0x4C, 0xCC, 0xCD,  # 0.2
    0x3E, 0x99, 0x99, 0x9A,  # 0.3
    # PID误差: -0.05, 0.1, -0.15
    0xBD, 0x4C, 0xCC, 0xCD,  # -0.05
    0x3D, 0xCC, 0xCC, 0xCD,  # 0.1
    0xBE, 0x19, 0x99, 0x9A,  # -0.15
    # 校验和（需要计算，这里设为0）
    0x00
])

# 计算正确的校验和
checksum = sum(test_frame[:-1]) & 0xFF
test_frame = test_frame[:-1] + bytes([checksum])

# 导出主要类
__all__ = [
    'ANOFunctionCode',
    'VibrationData',
    'ANOFrame',
    'ANOProtocolParser',
    'VibrationDataParser',
    'test_frame',
]


if __name__ == '__main__':
    """模块自测"""
    print("ANO_DT协议解析模块自测")
    print("=" * 50)
    
    # 使用模块中定义的测试帧
    
    print(f"测试帧长度: {len(test_frame)} 字节")
    print(f"测试帧十六进制: {test_frame.hex()}")
    
    # 使用解析器解析
    parser = ANOProtocolParser()
    frames = parser.feed_bytes(test_frame)
    
    if frames:
        frame = frames[0]
        print(f"\n成功解析帧:")
        print(f"  功能码: 0x{frame.function_code:02X}")
        print(f"  数据长度: {len(frame.data)} 字节")
        print(f"  校验和有效: {frame.is_valid}")
        
        # 解析振动数据
        if frame.function_code == ANOFunctionCode.VIBRATION:
            vib_data = VibrationDataParser.parse(frame)
            if vib_data:
                print(f"\n振动数据解析成功:")
                print(f"  时间戳: {vib_data.timestamp_ms} ms")
                print(f"  原始陀螺仪: ({vib_data.raw_gx}, {vib_data.raw_gy}, {vib_data.raw_gz}) °/s")
                print(f"  滤波角速度: ({vib_data.filt_gx:.2f}, {vib_data.filt_gy:.2f}, {vib_data.filt_gz:.2f}) °/s")
                print(f"  PID输出: ({vib_data.pid_roll_out:.3f}, {vib_data.pid_pitch_out:.3f}, {vib_data.pid_yaw_out:.3f})")
                print(f"  PID误差: ({vib_data.pid_roll_err:.3f}, {vib_data.pid_pitch_err:.3f}, {vib_data.pid_yaw_err:.3f})")
                
                # 测试CSV输出
                print(f"\nCSV头部: {vib_data.get_csv_header()}")
                print(f"CSV行示例: {vib_data.to_csv_row()}")
            else:
                print("振动数据解析失败")
    else:
        print("帧解析失败")
    
    print("\n模块测试完成。")