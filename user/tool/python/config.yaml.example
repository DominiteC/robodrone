# ANO_DT高频振动数据采集工具配置文件示例
# 复制此文件为 config.yaml 并修改相应配置

# 串口配置
serial:
  port: "auto"           # 串口设备路径，设置为"auto"可自动检测
                         # Windows示例: "COM3"
                         # Linux示例: "/dev/ttyUSB0" 或 "/dev/ttyACM0"
  baudrate: 256000       # 波特率，必须与飞控设置一致
  timeout: 0.1           # 读取超时时间（秒）
  bytesize: 8            # 数据位
  stopbits: 1            # 停止位
  parity: "N"            # 校验位：N(无)、E(偶)、O(奇)

# 数据保存配置
data:
  save_dir: "./data"     # 数据保存目录（相对或绝对路径）
  filename_format: "vibration_{timestamp}.csv"  # 文件名格式
                         # 可用变量：{timestamp}、{date}、{time}
  max_file_size_mb: 50   # 最大文件大小（MB），超过则创建新文件
  max_duration_min: 60   # 最大记录时间（分钟），0表示无限制
  
  # CSV格式配置
  csv:
    delimiter: ","       # 分隔符
    newline: "\n"        # 换行符
    write_header: true   # 是否写入CSV头部
    
  # 二进制格式配置（可选）
  binary:
    enabled: false       # 是否启用二进制格式保存
    format: "raw"        # 格式：raw(原始帧)、struct(结构化)

# 转发配置（可选，用于透明转发给ANO地面站）
forward:
  enabled: false         # 是否启用转发功能
  type: "virtual"        # 转发类型：virtual(虚拟串口)、file(文件)、network(网络)
  
  # 虚拟串口转发配置
  virtual_port: "COM4"   # 转发目标虚拟串口
  virtual_baudrate: 256000  # 虚拟串口波特率
  
  # 网络转发配置（当type为network时）
  network:
    host: "127.0.0.1"    # 目标主机
    port: 8888           # 目标端口
    protocol: "tcp"      # 协议：tcp、udp
    
  # 过滤规则（哪些帧需要转发）
  filter:
    include_all: true    # 转发所有帧
    # 或指定功能码列表
    # function_codes: [0x00, 0x01, 0x02, 0x03, 0x05, 0x06]

# 日志配置
logging:
  level: "INFO"          # 日志级别：DEBUG、INFO、WARNING、ERROR、CRITICAL
  console: true          # 是否输出到控制台
  file: "./logs/capture.log"  # 日志文件路径，为空则不保存到文件
  max_size_mb: 10        # 最大日志文件大小（MB）
  backup_count: 5        # 保留的备份文件数量

# 监控配置
monitor:
  update_interval_sec: 1     # 监控信息更新间隔（秒）
  display_stats: true        # 是否显示统计信息
  
  # 统计信息显示内容
  stats_to_display:
    - frame_rate
    - vibration_rate
    - bytes_per_sec
    - error_count
    - buffer_usage
    
  # 阈值警告
  thresholds:
    frame_rate_low: 180      # 帧率过低警告（Hz）
    buffer_high: 0.8         # 缓冲区使用率过高警告（0.0-1.0）

# 高级配置（通常无需修改）
advanced:
  # 解析器配置
  parser:
    max_frame_size: 64       # 最大帧大小（字节）
    buffer_size: 4096        # 缓冲区大小（字节）
    
  # 性能配置
  performance:
    use_threading: true      # 是否使用多线程处理
    save_batch_size: 100     # 批量保存记录数
    flush_interval_sec: 5    # 数据刷盘间隔（秒）
    
  # 调试配置
  debug:
    dump_invalid_frames: false  # 是否保存无效帧用于调试
    dump_dir: "./debug"      # 调试数据保存目录
    hex_dump: false          # 是否以十六进制显示原始数据

# 注释说明
_comment: |
  配置说明：
  1. 首次使用时，复制此文件为 config.yaml
  2. 修改 serial.port 为您的串口设备路径
  3. 确保 serial.baudrate 与飞控设置一致（256000）
  4. data.save_dir 目录需有写入权限
  5. 如需转发功能，设置 forward.enabled 为 true 并配置相应参数